{
  "name": "purescript-env",
  "version": "0.1.0",
  "description": "Configuration from the process environment, as one typed record, with a .env file folded in",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "spago build",
    "test": "spago test",
    "format": "purs-tidy format-in-place \"src/**/*.purs\" \"test/**/*.purs\"",
    "format:check": "purs-tidy check \"src/**/*.purs\" \"test/**/*.purs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-rinaldi/purescript-env.git"
  },
  "license": "MIT",
  "devDependencies": {
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "spago": "^1.0.4"
  }
}
